# App version (displayed in Settings > About)
# VITE_APP_VERSION=0.0.0

# Build mode: oss = open-source (user provides own API key), commercial = paid version (activation required)
# VITE_BUILD_MODE=oss

# DeepSeek API key for AI subtitle processing (required for both oss and commercial modes)
# VITE_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# HMAC secret key for generating and validating activation codes (commercial mode only, min 32 chars)
# CADENCE_ACTIVATION_SECRET=your-hmac-secret-at-least-32-chars

# Maximum number of activation codes that can be validated with the above secret (commercial mode only)
# CADENCE_MAX_CODES=1000
