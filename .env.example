# App version (displayed in Settings > About)
# VITE_APP_VERSION=0.0.0

# Build mode: oss (open-source, user provides own API key) | commercial (activation required)
# VITE_BUILD_MODE=oss

# DeepSeek API key for AI subtitle processing (required for both modes)
# VITE_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# HMAC secret key for activation code validation (commercial mode only, min 32 chars)
# CADENCE_ACTIVATION_SECRET=your-hmac-secret-at-least-32-chars

# Max activation codes that can be validated with the above secret (commercial mode only, default 1000)
# CADENCE_MAX_CODES=1000

# Dev-only: override activation state for testing. Values: expired | trial | activated
# VITE_EXPIRE_MODE=expired
