{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadence Desktop",
  "version": "0.6.6",
  "identifier": "com.avonyu.cadence-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cadence Desktop",
        "width": 1000,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "img-src": "'self' asset: http://asset.localhost blob: data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNUE0OUMyQ0IzQjg5MjgKUldRb2lUdkx3a2xhYi9OQWorandZQzEwMHdNK29VL3U5QjdRVHZoS25mNkFoby9OcEVLcWVWVW4K",
      "endpoints": [
        "https://github.com/avonyu/cadence-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
